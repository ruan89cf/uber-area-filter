    <string name="whats_new_version_pill">Novidades da versão 1.2</string>
    <string name="whats_new_headline">Mais segurança e lucro real em cada corrida.</string>
    <string name="whats_new_lead">Veja o que o app passa a fazer por você enquanto suas mãos ficam na direção.</string>

    <string name="whats_new_group_safety">Segurança</string>
    <string name="whats_new_zones_title">Zonas desenhadas no mapa</string>
    <string name="whats_new_zones_body">Marque polígonos e círculos como área permitida ou proibida. O app extrai as ruas sozinho e aplica regras por via, como aceitar só o lado ímpar da Av. Brasil.</string>
    <string name="whats_new_dual_title">Modo duplo 99 + Uber</string>
    <string name="whats_new_dual_body">Rode com os dois apps ligados. Ao aceitar uma corrida, o outro fica travado. Se a corrida cair, o chip flutuante libera a trava com um toque.</string>

    <string name="whats_new_group_profit">Rentabilidade</string>
    <string name="whats_new_fuel_title">R$/h líquido, sem ilusão</string>
    <string name="whats_new_fuel_body">Informe o consumo e o preço da gasolina, etanol ou GNV. O filtro desconta o combustível do trajeto inteiro e conta o tempo de busca, espera e viagem.</string>

    <string name="whats_new_group_ease">Praticidade</string>
    <string name="whats_new_shots_title">Print de cada oferta</string>
    <string name="whats_new_shots_body">Toda corrida que toca gera um print silencioso, guardado só dentro do app. Abra pelo histórico para conferir por que ela foi aceita ou recusada.</string>
    <string name="whats_new_favorites_title">Passageiros favoritos</string>
    <string name="whats_new_favorites_body">Cadastre clientes fixos com endereço e horário. O app avisa 30, 20 e 10 minutos antes para você se posicionar.</string>
    <string name="whats_new_layout_title">Painel organizado em grupos</string>
    <string name="whats_new_layout_body">Cada assunto tem o seu bloco, e o diagnóstico e os logs ficam recolhidos até você precisar deles.</string>

    <string name="whats_new_cta">Abrir painel principal</string>
