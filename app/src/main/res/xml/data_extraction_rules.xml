<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: prints das corridas (com enderecos de passageiros) nao vao para o backup na nuvem.
     Zonas e configuracoes continuam no backup para facilitar a troca de aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="ride_shots" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ride_shots" />
    </device-transfer>
</data-extraction-rules>
